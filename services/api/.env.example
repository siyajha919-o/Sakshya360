PORT=4000
DATABASE_URL=postgres://sakshya:sakshya@localhost:5432/sakshya360
MONGO_URL=mongodb://localhost:27017
MONGO_DB=sakshya360_evidence
ML_URL=http://127.0.0.1:8001
MEDIAMTX_URL=http://127.0.0.1:8889
MEDIAMTX_API_URL=http://127.0.0.1:9997
RTSP_BASE_URL=rtsp://127.0.0.1:8554
JITSI_DOMAIN=meet.jit.si
# Required in production (>= 32 random chars):  openssl rand -hex 32
JWT_SECRET=change-me-in-production
# Comma-separated web origins; '*' only for development.
CORS_ORIGINS=*
PUBLIC_WEB_URL=http://localhost:5180

# Background jobs (auto-assignment, overdue, camera health, CCTV checks)
JOBS_ENABLED=true
CAMERA_HEALTH_INTERVAL_S=60
CCTV_WATCH_INTERVAL_S=120

# Beneficiary OTP. Without SMS_WEBHOOK_URL the OTP is returned in the API response (dev only).
# The webhook receives POST {"to": "+91XXXXXXXXXX", "message": "..."} with Bearer SMS_WEBHOOK_TOKEN.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Expo push (optional access token if "enhanced push security" is on in your Expo account)
EXPO_ACCESS_TOKEN=

# Parichay / Jan Parichay SSO (any OIDC provider). Enabled when all four are set.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/auth/sso/callback
